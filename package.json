{
  "name": "Nexux",
  "version": "1.0.0",
  "description": "Nexux ERP System - Multi-tenant Nuxt 4 Monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter admin dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:hr": "pnpm --filter hr dev",
    "dev:employee": "pnpm --filter employee dev",
    "dev:manager": "pnpm --filter manager dev",
    "dev:accountant": "pnpm --filter accountant dev",
    "dev:inventory-manager": "pnpm --filter inventory-manager dev",
    "dev:maintenance-technician": "pnpm --filter maintenance-technician dev",
    "dev:system-auditor": "pnpm --filter system-auditor dev",
    "dev:td-officer": "pnpm --filter td-officer dev",
    "build": "pnpm -r build",
    "build:admin": "pnpm --filter admin build",
    "build:hr": "pnpm --filter hr build",
    "build:employee": "pnpm --filter employee build",
    "build:manager": "pnpm --filter manager build",
    "build:accountant": "pnpm --filter accountant build",
    "build:inventory-manager": "pnpm --filter inventory-manager build",
    "build:maintenance-technician": "pnpm --filter maintenance-technician build",
    "build:system-auditor": "pnpm --filter system-auditor build",
    "build:td-officer": "pnpm --filter td-officer build",
    "install:all": "pnpm install"
  },
  "keywords": [
    "erp",
    "nuxt",
    "monorepo"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.0",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
